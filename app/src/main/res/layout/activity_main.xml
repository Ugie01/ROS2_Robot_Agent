<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- 상단 2단 헤더 -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domain:"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDomainId"
                android:layout_width="45dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="#2C2C2C"
                android:gravity="center"
                android:inputType="number"
                android:padding="2dp"
                android:text="24"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spnGlobalQos"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#2C2C2C" />

            <TextView
                android:id="@+id/tvBatteryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🔋 --%"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNodeToggle"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#388E3C"
                android:elevation="4dp"
                android:text="노드 시작"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="● 노드 중지됨"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:background="#1A1A1A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:tabGravity="fill"
        app:tabIndicatorColor="#00E5FF"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#00E5FF"
        app:tabTextColor="#888888">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 수동 주행 / 센서" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 AI 자율주행 / POI" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <!-- ================= Tab 1: 주행 & 센서 ================= -->
        <LinearLayout
            android:id="@+id/tabDriveSensors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible">

            <com.example.robot_agent.LaserScanView
                android:id="@+id/laserScanView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#181818" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMaxSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최대속도: 0.50 m/s"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbMaxSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />

                <Spinner
                    android:id="@+id/spnCmdVelType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2C2C2C" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVelocity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="center"
                android:text="Linear: 0.00 m/s | Angular: 0.00 rad/s (정지)"
                android:textColor="#00E5FF"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.2">

                <com.example.robot_agent.JoystickView
                    android:id="@+id/joystickView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btnEmergencyStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:backgroundTint="#FF1744"
                    android:text="🛑 E-STOP"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- ================= Tab 2: Gemini AI 에이전트 & POI ================= -->
        <LinearLayout
            android:id="@+id/tabAiAgent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <com.example.robot_agent.MapView
                android:id="@+id/mapViewAi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1"
                android:background="#181818" />

            <!-- 상단 컨트롤 버튼군 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeInitialPose"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00897B"
                    android:text="위치추정"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btnAddPoiMode"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7B1FA2"
                    android:text="POI 등록"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btnSavePoi"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#303F9F"
                    android:text="POI 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btnParamSettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F57C00"
                    android:text="파라미터"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btnCancelNav"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="0.8"
                    android:backgroundTint="#C62828"
                    android:text="정지"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- 챗봇 대화 로그창 -->
            <ScrollView
                android:id="@+id/svChatLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9"
                android:background="#151515"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvChatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="🤖 [터틀] 준비 완료! '헤이 터틀' 또는 음성/텍스트로 명령하세요.\n(예: '식탁으로 가줘', '주방으로 이동해')"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVoiceStt"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#FF6F00"
                    android:padding="0dp"
                    android:text="🎤"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etUserChat"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#2C2C2C"
                    android:hint="명령어 입력 (예: 식탁으로 가줘)"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSendChat"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#00C853"
                    android:text="전송"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearChat"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#424242"
                    android:text="지우기"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>